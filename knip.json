{
  "$schema": "./node_modules/knip/schema.json",
  "includeEntryExports": true,
  "ignoreWorkspaces": ["packages/tsconfig"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{ts,mjs}!"],
      "project": ["scripts/**/*.{ts,mjs}!"],
      "ignoreDependencies": [
        "effect",
        "@effect/platform-node",
        "@effect/vitest"
      ]
    },
    "packages/*": {
      "project": ["src/**/*.ts!", "!src/testing/**!"]
    },
    "apps/cli": {
      "entry": ["src/bin.ts!"],
      "project": ["src/**/*.ts!", "!src/testing/**!"],
      "ignoreBinaries": ["mkfifo"]
    },
    "packages/viewer": {
      "entry": ["src/main.ts!"],
      "project": ["src/**/*.ts!", "!src/testing/**!"]
    }
  },
  "ignore": [
    "packages/engine/src/badges/area-badges.ts",
    "packages/engine/src/badges/contributor-badges.ts",
    "packages/engine/src/highlights/highlights.ts",
    "packages/engine/src/highlights/history-events.ts",
    "packages/engine/src/highlights/knowledge-facts.ts",
    "packages/engine/src/highlights/rhythm.ts"
  ]
}
